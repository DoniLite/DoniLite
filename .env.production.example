# Env vars to set in Coolify for the docker-compose.prod.yml stack.
# DATABASE_URL itself is NOT set here — it's assembled from DB_USER/DB_PASSWORD/
# DB_NAME inside docker-compose.prod.yml, pointing at the bundled `db` service.

DB_USER="doni"
DB_PASSWORD=
DB_NAME="doni_db"

DEFAULT_AUTH=
DEFAULT_AUTH_PASSWORD=
SERVER_KEY=

GITHUB_TOKEN=

MYMEMORY_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Doni Lite <no-reply@example.com>"

# Public URL Coolify will serve this app on (used for canonical/OG/hreflang
# tags and links in outbound emails).
SITE_URL=
