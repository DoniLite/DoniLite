DB_USER="doni"
DB_PASSWORD="donidb1234thisisanexample"
DB_NAME="doni_db"
DB_HOST="localhost"
DB_PORT="5454"
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public&connection_limit=5"

DEFAULT_AUTH=
DEFAULT_AUTH_PASSWORD=
SERVER_KEY=

# Required in production: without it, GitHub repo fetching falls back to
# unauthenticated requests, capped at 60 req/hour shared across all visitors.
GITHUB_TOKEN=

# Optional, free: used for the "Translate to EN/FR" action (via MyMemory,
# api.mymemory.translated.net). No signup or fees — setting your email here
# just roughly doubles the free daily word quota (~5,000 -> ~10,000).
MYMEMORY_EMAIL=

# Required for outbound email (newsletter sends + inbox replies). Any SMTP
# provider works (Gmail app password, Zoho, a transactional-email provider's
# SMTP endpoint, your own mail server, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Doni Lite <no-reply@example.com>"

# Public base URL of the site, used to build absolute links (article links,
# logo, unsubscribe link) inside emails. Defaults to http://localhost:4040
# in development if unset.
SITE_URL=
